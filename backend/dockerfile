# slim (glibc) so binary wheels (pymongo, cryptography, ...) install without
# compiling; alpine's musl has no wheels for some of them
FROM python:3.13-slim

WORKDIR /app
# Application packages are copied individually (copying parent dirs would
# flatten them: COPY of a directory copies its *contents*)
ENV PYTHONPATH=/app PYTHONDONTWRITEBYTECODE=1

COPY app.py requirements.txt /app/
COPY cache /app/cache
COPY database /app/database
COPY models /app/models
COPY routers /app/routers
COPY utils /app/utils

RUN pip install --no-cache-dir --only-binary :all: -r requirements.txt # Compliant: exact versions are pinned in requirements.txt
RUN useradd --system --create-home --uid 10001 appuser
USER appuser

EXPOSE 8000
# Heroku routes web traffic to $PORT; fall back to 8000 for local runs
CMD ["sh", "-c", "gunicorn -w 2 -k uvicorn.workers.UvicornWorker app:app --bind 0.0.0.0:${PORT:-8000}"]
